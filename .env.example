# ==============================================================================
# SALO Frontend Environment Configuration Example (Vite + React)
# ==============================================================================
# Copy this file to ".env" for local development.
# Only public VITE_ variables belong here — never add backend secrets.

VITE_APP_NAME=SALO
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api

# Set to "false" when using real backend authentication
VITE_ENABLE_DEMO_AUTH=true
