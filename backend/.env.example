# ==============================================================================
# SALO Backend Environment Configuration Example (Laravel + MySQL + XAMPP)
# ==============================================================================
# Copy this file to "backend/.env" and fill in your local values.
# Safe to commit — contains placeholder values only.

# ------------------------------------------------------------------------------
# A. Application Settings
# ------------------------------------------------------------------------------
APP_NAME=SALO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000/api

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# B. Database Configuration (Local XAMPP MySQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# ------------------------------------------------------------------------------
# C. Email Configuration (SMTP for OTP Verification)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=your_smtp_host
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_sender_email@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# D. Authentication & Security (Laravel Sanctum + OTP)
# ------------------------------------------------------------------------------
# SALO uses Laravel Sanctum Bearer tokens and session cookies (not JWT).
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SANCTUM_TOKEN_EXPIRATION=1440

SESSION_DRIVER=database
SESSION_LIFETIME=120

OTP_EXPIRATION_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LENGTH=6

# ------------------------------------------------------------------------------
# E. File Storage (Local Storage Only — No Cloud/S3)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local
MAX_UPLOAD_SIZE_KB=5120
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
ALLOWED_DOCUMENT_TYPES=pdf,jpg,jpeg,png

CACHE_STORE=database
QUEUE_CONNECTION=sync
