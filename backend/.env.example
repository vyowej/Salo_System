# ==============================================================================
# SALO Backend Environment Configuration Example (Laravel + MySQL + XAMPP)
# ==============================================================================
# Copy this file to "backend/.env" and fill in your local values.
# Safe to commit â€” contains placeholder values only.

# ------------------------------------------------------------------------------
# A. Application Settings
# ------------------------------------------------------------------------------
APP_NAME=SALO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000/api

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# B. Database Configuration (Local XAMPP MySQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salo_db
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# ------------------------------------------------------------------------------
# C. Email Configuration (SMTP for OTP Verification)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=your_smtp_host
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_sender_email@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# D. Authentication & Security (Session + OTP)
# ------------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120

OTP_EXPIRATION_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LENGTH=6

# ------------------------------------------------------------------------------
# E. File Storage (Local Public Disk â€” No Cloud/S3)
# ------------------------------------------------------------------------------
# Uses storage/app/public exposed via "php artisan storage:link" (public/storage)
FILESYSTEM_DISK=public
MAX_UPLOAD_SIZE_KB=5120
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
ALLOWED_DOCUMENT_TYPES=pdf,jpg,jpeg,png

CACHE_STORE=file
QUEUE_CONNECTION=sync

# ------------------------------------------------------------------------------
# F. Location & Mapping Services (Free OpenStreetMap + PSGC)
# ------------------------------------------------------------------------------
# OpenStreetMap tile URL template
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Official Philippine Standard Geographic Code (PSGC) API base URL
PSGC_API_BASE_URL=https://psgc.gitlab.io/api
